{
  "name": "crt-lineas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "pw:auth": "node scripts/playwright-auth-setup.js",
    "pw:open": "node scripts/playwright-open-with-session.js",
    "db:generate": "node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push --skip-generate && node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev --skip-generate && node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "db:clear-companies": "node --env-file=.env.local scripts/clear-companies-data.js",
    "test:auth": "vitest run tests/auth",
    "test:observability": "node scripts/sentry-probe.mjs",
    "test:sentry-probe": "npm run test:observability",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.3.1",
    "@prisma/client": "^6.19.3",
    "@scalar/nextjs-api-reference": "^0.9.26",
    "@sentry/nextjs": "^10.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "inngest": "^3.54.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "playwright": "^1.59.1",
    "react": "19.2.4",
    "react-dom": "19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
