# Neon / Postgres
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require&channel_binding=require"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_OUT_URL=/sign-in

# Clave AES-256 (32 bytes en base64) para cifrar CURP/celular en Neon. Generar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VERIFICATION_CREDENTIALS_ENCRYPTION_KEY=

# (Opcional, solo desarrollo local sin UI) — sustituido por perfil de usuario en /dashboard/setup
MONITOR_CURP=
MONITOR_PHONE=

# Playwright: "true" opens a visible browser (recommended for semi-manual checks)
PLAYWRIGHT_HEADED=true

# Max wait (ms) for operator to complete captcha / manual steps during a check
MONITOR_MANUAL_WAIT_MS=120000

# Delay (ms) between same-host checks in POST /api/monitor/bulk (default 5000)
MONITOR_BULK_DELAY_MS=5000

# Max time (ms) per item in POST /api/monitor/bulk before Playwright is aborted (default 20000)
MONITOR_BULK_ITEM_TIMEOUT_MS=180000

# API docs — Scalar at GET /api-docs (OpenAPI JSON at GET /api/openapi; no env vars required)

# Inngest — transporte de jobs de navegador (scraping + verificación).
# Ejecutados por el worker Hetzner (Inngest Connect); Vercel solo encola.
# Claves compartidas Vercel↔worker. Local dev: `npx inngest-cli@latest dev`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Flag de coexistencia: por defecto Vercel NO sirve las funciones de navegador
# (el worker Hetzner es el ejecutor único). Poner en 1 solo para rollback, tras
# restaurar @sparticuz/chromium y su config. Ver docs/ENV.md.
# INNGEST_SERVE_BROWSER_ON_VERCEL=0

# Worker Hetzner: ver .env.worker.example para las envs del contenedor.

# Sentry — https://sentry.io (project: crt-lineas)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=crt-lineas
SENTRY_AUTH_TOKEN=

# UploadThing — token del dashboard (SDK servidor). Si está definido, las capturas del monitor se suben como privadas en lugar de solo disco local.
# UPLOADTHING_TOKEN=
