# Variables del worker Hetzner (copiar a .env.worker en el VPS; NO versionar).
# Ver docs/ENV.md para el detalle de cada una.

# Base de datos Neon (compartida con Vercel).
DATABASE_URL=

# Inngest Cloud (mismas claves que Vercel).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cifrado de credenciales de verificación (misma clave que Vercel).
VERIFICATION_CREDENTIALS_ENCRYPTION_KEY=

# Subida de capturas de revisión (mismo token que Vercel).
UPLOADTHING_TOKEN=

# Timeouts/waits del monitor (opcionales; tienen defaults).
# MONITOR_MANUAL_WAIT_MS=120000
# MONITOR_BULK_ITEM_TIMEOUT_MS=20000
# MONITOR_BULK_DELAY_MS=5000

# Operación del worker (opcionales).
# WORKER_HEALTH_PORT=3100
# WORKER_CONCURRENCY=1
# WORKER_INSTANCE_ID=crt-lineas-worker
